# ---------------------------------------------------------------
# Text LLM (writes the storyboard, and draws sketch frames)
# Tried in LLM_PROVIDERS order; providers without a key are skipped.
# No key at all -> deterministic mock storyboard.
# ---------------------------------------------------------------
LLM_PROVIDERS=gemini,deepseek,custom

# Google AI Studio (free tier covers Flash text models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Any other OpenAI-compatible endpoint (OpenRouter, SiliconFlow, Qwen, Ollama, ...)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------------------------------------------------------------
# Image generation
# Tried per scene in IMAGE_PROVIDERS order; unconfigured ones are skipped.
# A provider that returns 401/402/403/429 is skipped for the rest of the run.
# Nothing works -> placeholder SVG frames.
# ---------------------------------------------------------------
IMAGE_PROVIDERS=cloudflare,huggingface,pollinations,sketch
IMAGE_CONCURRENCY=3

# Cloudflare Workers AI (~170 free FLUX.1-schnell images per day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_STEPS=4

# Hugging Face Inference
HF_TOKEN=
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Pollinations: set a token, or POLLINATIONS_ANONYMOUS=1 for the slow keyless tier
POLLINATIONS_TOKEN=
POLLINATIONS_ANONYMOUS=0
# POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
# POLLINATIONS_MODEL=flux

# Sketch: the text LLM draws a line-art storyboard frame as SVG (text tokens only)
SKETCH_ENABLED=1

# ---------------------------------------------------------------
# Voice (edge-tts, free, no key)
# ---------------------------------------------------------------
# TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
# TTS_VOICE_EN=en-US-AvaNeural

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for per-deploy URLs such as Vercel previews:
# CORS_ORIGIN_REGEX=https://ugc-storyboard-[a-z0-9]+-ruyu-s-projects\.vercel\.app
# GENERATED_TTL_SEC=21600
